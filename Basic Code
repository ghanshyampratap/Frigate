mqtt:

  enabled: true

  host: 192.168.10.37

  port: 1883

  topic_prefix: frigate

  client_id: frigate

detectors:

  hailo:

    type: hailo8l

    device: PCIe

ffmpeg:

  global_args:

   - -hide_banner

   - -loglevel

   - warning

semantic_search:

  enabled: false

face_recognition:

  enabled: true

  model_size: small

lpr:

  enabled: false

objects:

  track:

    - person

    - car

    - truck

    - motorcycle

    #- bicycle

    - bus

    #- train

    #- traffic light

    #- stop sign

    #- parking meter

    - chair

    #- tv

    - bottle

    - laptop

    #- mouse

    #- backpack

    #- handbag

    #- suitcase

   #- umbrella

    #- dog

    #- cat



snapshots:

  enabled: true

  timestamp: true

  bounding_box: true

  retain:

    default: 4

record:

  enabled: true

  alerts:

    retain:

      days: 2

      mode: motion

  detections:

    retain:

      days: 4

      mode: motion

go2rtc:

  streams:

    prama_dome:

      - rtsp://admin:Prama12%2521@192.168.10.4:554/Streaming/Channels/101

    prama_dome_sub:

      - rtsp://admin:Prama12%2521@192.168.10.4:554/Streaming/Channels/102

    prama_bullet:

      - rtsp://admin:Prama12!@192.168.10.64:554/Streaming/Channels/101

    prama_bullet_sub:

      - rtsp://admin:Prama12!@192.168.10.64:554/Streaming/Channels/102

    aqara_doorbell:

      - rtsp://155:293@192.168.10.20:8554/ch3



cameras:

  trueview:

    ffmpeg:

      inputs:

        - path: rtsp://admin:@192.168.10.221:554/ch0_0.264

          roles:

            - detect

            - record

      global_args:

        - -rtsp_transport

        - tcp

    detect:

      enabled: true

      width: 640

      height: 480

      fps: 2

    motion:

      threshold: 25

      contour_area: 30

    record:

      enabled: true

  prama_dome:

    ffmpeg:

      inputs:

        - path: rtsp://localhost:8554/prama_dome

          roles:

            - record

        - path: rtsp://localhost:8554/prama_dome_sub

          roles:

            - detect

      global_args:

        - -rtsp_transport

        - tcp

    detect:

      enabled: true

      width: 640

      height: 480

      fps: 5

    motion:

      threshold: 25

      contour_area: 30

    record:

      enabled: true



prama_bullet:

    ffmpeg:

      inputs:

        - path: rtsp://localhost:8554/prama_bullet

          roles:

            - record

        - path: rtsp://localhost:8554/prama_bullet_sub

          roles:

            - detect

      global_args:

        - -rtsp_transport

        - tcp

    detect:

